# ==============================================================================
# CONFIGURAÇÕES DO GATEWAY UNIFICADO DE WHATSAPP
# ==============================================================================

NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Chave de Autenticação da API REST (Bearer Token)
API_SECRET_KEY=sua_chave_mestra_secreta_aqui

# Diretórios
SESSIONS_DIR=./sessions
TEMP_DIR=./temp

# Webhooks Globais (Opcional - Pode ser configurado por sessão)
DEFAULT_WEBHOOK_URL=http://localhost:3000/api/webhook
WEBHOOK_SECRET=segredo_assinatura_hmac

# Integração Chatwoot
CHATWOOT_ENABLED=false
CHATWOOT_BASE_URL=https://chatwoot.suaempresa.com
CHATWOOT_API_TOKEN=token_do_chatwoot

# Integração Typebot
TYPEBOT_ENABLED=false
TYPEBOT_BASE_URL=https://typebot.suaempresa.com

# Motor FFmpeg para Normalização de Áudio PTT
FFMPEG_PATH=ffmpeg
